# .env.example — Slow Light Sanctuary Environment Configuration
# Labels: PUBLIC = browser-safe (starts with VITE_); SERVER = non-secret server config; SECRET-REF = secret identifier.
# Anything not PUBLIC MUST NEVER reach the browser. Placeholders only.

# ---------- PUBLIC (browser-safe) ----------
VITE_SITE_ORIGIN=https://app.example.com
VITE_ADMIN_ORIGIN=https://door-x7k2.example.com
VITE_BUILD_ID=dev

# ---------- SERVER (never to the browser) ----------
NODE_ENV=development
PORT=3000
SITE_ORIGIN=https://app.example.com
WEBAUTHN_RP_ID=example.com
WEBAUTHN_RP_NAME=Slow Light
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slowlight
ADMIN_DOOR_IP=

# ---------- AWS & STORAGE ----------
AWS_REGION=ap-south-1
S3_QUARANTINE_BUCKET=sl-quarantine
S3_MEDIA_BUCKET=sl-media
S3_VAULT_BUCKET=sl-vault
KMS_SEALED_KEY_ID=alias/sl-sealed
KEY_SERVICE=local # 'kms' in production; 'local' for dev

# ---------- CLOUDFRONT SIGNING ----------
CLOUDFRONT_DOMAIN=media.example.com
CLOUDFRONT_KEY_PAIR_ID=K123EXAMPLE
CLOUDFRONT_PRIVATE_KEY=""

# ---------- WORKER & ALERTS ----------
LOG_LEVEL=info
